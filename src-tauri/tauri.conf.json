{
  "productName": "Whisper",
  "version": "0.1.0",
  "identifier": "com.whisper.service",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd ../frontend && pnpm dev"
  },
  "app": {
    "windows": [
      {
        "title": "Whisper 语音转文字",
        "width": 900,
        "height": 720,
        "center": true,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/whisper-backend"],
    "resources": []
  }
}
